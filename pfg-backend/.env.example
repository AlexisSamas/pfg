# ---- Base de datos ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pfg_db

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0
ENABLE_REDIS=false

# ---- Seguridad y JWT ----
SECRET_KEY=development-secret-key-32-chars-long-or-more-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- Lógica de Negocio / Evaluación Cognitiva ----
DEFAULT_ATTENTION_THRESHOLD=60.0
DEFAULT_WAIT_MINUTES=10
MAX_ATTEMPTS=3
